#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled device_id device_secret product_id

	config_load 'tuya-daemon'
	config_get enabled main 'enabled' '0'
	config_get device_id main 'device_id'
	config_get device_secret main 'device_secret'
	config_get product_id main 'product_id'

	[ "$enabled" -eq 1 ] || {
		logger -t tuya-daemon "Service disabled in config, not starting"
		return 0
	}

	if [ -z "$device_id" ] || [ -z "$device_secret" ] || [ -z "$product_id" ]; then
		logger -t tuya-daemon "Missing device_id/device_secret/product_id in /etc/config/tuya-daemon"
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/tuya-daemon \
		-d "$device_id" \
		-s "$device_secret" \
		-p "$product_id"
	procd_set_param file /etc/config/tuya-daemon
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "tuya-daemon"
}

reload_service() {
	stop
	start
}
